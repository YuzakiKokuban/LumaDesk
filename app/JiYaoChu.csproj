<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>JiYaoChu</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>packages.$(Configuration).lock.json</NuGetLockFilePath>

    <!-- Unpackaged desktop executable; firmware access requires elevation. -->
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <DisableMsixProjectCapabilityAddedByProject>true</DisableMsixProjectCapabilityAddedByProject>
    <DisableHasPackageAndPublishMenuAddedByProject>true</DisableHasPackageAndPublishMenuAddedByProject>

    <!-- Share the system .NET and Windows App SDK runtimes. -->
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <SelfContained>false</SelfContained>

    <AssemblyName>机耀处</AssemblyName>
    <Version>0.2.0-beta.1</Version>
    <FileVersion>0.2.0.0</FileVersion>
    <Product>机耀处 · LumaDesk</Product>
    <Company>JiYaoChu</Company>
    <Copyright>MIT</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    The Rust core.

    src/ffi.rs exports a small C ABI over the same command dispatcher the
    headless jiyaochu-ctl front end drives; this project is the second consumer.
    The DLL has to sit next to JiYaoChu.exe, so it is copied into the output
    directory on every build. Build the Rust half first:

      cargo build                      (debug)   -> target\debug\jiyaochu_core.dll
      cargo build with the release opt (release) -> target\release\jiyaochu_core.dll
  -->
  <PropertyGroup>
    <CoreProfile Condition="'$(Configuration)' == 'Debug'">debug</CoreProfile>
    <CoreProfile Condition="'$(Configuration)' != 'Debug'">release</CoreProfile>
    <CoreLibrary>$(MSBuildThisFileDirectory)..\target\$(CoreProfile)\jiyaochu_core.dll</CoreLibrary>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(CoreLibrary)" Link="jiyaochu_core.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <Target Name="RequireRustCore" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(CoreLibrary)')"
           Text="jiyaochu_core.dll is missing at $(CoreLibrary). Run 'cargo build' (Debug) or 'cargo build --release' (Release) in the repository root first." />
  </Target>

  <!-- The merged main PRI is required for theme lookup in unpackaged publish. -->
  <Target Name="PublishMainResourceIndex" AfterTargets="Publish">
    <Error Condition="!Exists('$(OutDir)$(AssemblyName).pri')" Text="Main WinUI resource index is missing." />
    <Copy SourceFiles="$(OutDir)$(AssemblyName).pri" DestinationFolder="$(PublishDir)" />
  </Target>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.5.1" />
    <PackageReference Include="Microsoft.UI.Reactor" Version="0.1.0-preview.16" />
  </ItemGroup>

  <!--
    Debug-only: enable the Reactor devtools surface so the devtools F5 profile
    (in Properties/launchSettings.json) lights up the devtools menu. Release /
    Publish builds drop the package and the host-config switch so the trim / AOT
    analyzers stay happy. To enable devtools in Release too, move these into the
    unconditioned ItemGroup above.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.UI.Reactor.Devtools" Version="0.1.0-preview.16" />
    <RuntimeHostConfigurationOption Include="Reactor.DevtoolsSupport" Value="true" Trim="true" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">False</PublishReadyToRun>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <!--
      Trimming stays OFF. The model records are deserialised by reflection, and
      the trimmer cannot see the properties it must keep, so a trimmed build
      compiles fine and then fails at run time on the first command. Revisit
      only together with a source-generated JsonSerializerContext.
    -->
    <PublishTrimmed>False</PublishTrimmed>
  </PropertyGroup>
</Project>
